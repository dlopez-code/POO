<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jazito.edadpersona.PrimaryController">
    <children>
        <HBox spacing="20" alignment ="CENTER">
            <Label text="Fecha de nacimiento" />
            <TextField fx:id="txtFechaNacimiento" />
        </HBox>
 
        <HBox spacing="15" alignment="CENTER">
            <Button fx:id="calcular" text="Calcular" onAction="#calcular"/>
            <Button fx:id="limpiar" text="Limpiar" onAction="#limpiar"/>
        </HBox>
        <Label text="Ingrese su fecha de nacimiento dd/mm/aaaa" fx:id="lblResultado"/>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
