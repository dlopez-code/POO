<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml/1"  alignment="CENTER" spacing="20.0"  fx:controller="com.jazito.gastossemanales.PrimaryController">
    <children>
        <VBox alignment="CENTER" spacing="20.0">
            <HBox alignment="CENTER" spacing="20.0">
                <Label text="Alimentación" />
                <TextField fx:id="txtAlimentacion"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label text="Refrigerios" />
                <TextField fx:id="txtRefrigerios"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label text="Transporte" />
                <TextField fx:id="txtTransporte"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label text="Telefonía" />
                <TextField fx:id="txtTelefonia"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label text="Otros" />
                <TextField fx:id="txtOtros"/>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Button fx:id="btnEstadisticas" text="Calcular estadísticas" onAction="#estadisticas"/>
                <Button fx:id="btnLimpiar" text="Limpiar" onAction="#limpiar"/>
            </HBox>
        </VBox>
        
            
       
        
        <VBox alignment="CENTER_RIGHT" spacing="20.0">
            <Label text="ESTADÍSTICAS" />
            <Label text="Total semanal" />
            <TextField fx:id="txtTotalSemanal"/>
            <Label text="Gasto más alto" />
            <TextField fx:id="txtMayorGasto"/>
        </VBox>
        
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</HBox>
