<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="com.jazito.cifrasydivisores.PrimaryController">
    <children>
        <HBox alignment="CENTER" spacing="20.0">
            <Label text="Ingrese un número" />
            <TextField  fx:id="txtNumero" />
            <Button fx:id="btnAnalizar" text="Analizar" onAction="#Analizar"/>
            <Button fx:id="btnLimpiar" text="Limpiar" onAction="#Limpiar"/>
        </HBox>
        
        <HBox alignment="CENTER" spacing="20.0">
            <Label text="Cantidad de cifras" />
            <TextField  fx:id="txtCanCifras" />
        </HBox>
        <HBox alignment="CENTER" spacing="20.0">
            <Label text="Suma de cifras impares" />
            <TextField  fx:id="txtSumaImpares" />
        </HBox>
        <HBox alignment="CENTER" spacing="20.0">
            <Label text="Suma de cifras pares" />
            <TextField  fx:id="txtSumaPares" />
        </HBox>
        <HBox alignment="CENTER" spacing="20.0">
            <Label text="Suma total de cifras" />
            <TextField  fx:id="txtSumTotal" />
        </HBox>
        <HBox alignment="CENTER" spacing="20.0">
            <Label text="Cifra mayor" />
            <TextField  fx:id="txtCifraMay" />
        </HBox>
        <HBox alignment="CENTER" spacing="20.0">
            <Label text="Cifra menor" />
            <TextField  fx:id="txtCifraMen" />
        </HBox>
        <Label text="Divisores"/>
        <TextArea fx:id="txtDivisores"/>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
