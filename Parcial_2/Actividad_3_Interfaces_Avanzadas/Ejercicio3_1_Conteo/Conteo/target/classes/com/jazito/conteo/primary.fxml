<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="30.0" fx:controller="com.jazito.conteo.PrimaryController">
    <children>
        <VBox alignment="CENTER" spacing="20.0">
            <Label text="Contar número de clics"/>
            <TextField fx:id="txtContador" text="0" editable="false"/>
            <Button text="¡Contar!" onAction="#contar"/>
        </VBox>

        <VBox alignment="CENTER" spacing="20.0">
            <Label text="Esperar 10 segundos"/>
            <ProgressBar fx:id="barraProgreso" progress="0.0" />
            <Button fx:id="btnEsperar" text="¡Esperar!" onAction="#esperar"/>
        </VBox>
    </children>

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>
</VBox>


