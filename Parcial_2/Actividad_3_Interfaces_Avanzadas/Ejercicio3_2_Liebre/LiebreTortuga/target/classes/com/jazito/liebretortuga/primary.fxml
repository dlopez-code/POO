<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jazito.liebretortuga.PrimaryController">
    <children>

        <VBox alignment="CENTER" spacing="20.0">
            <Label text="La Liebre y la Tortuga"/>
            <Button fx:id="btnIniciar" text="¡Iniciar Carrera!" onAction="#iniciarCarrera"/>
        </VBox>

        <VBox alignment="CENTER" spacing="20.0">
            <Label fx:id="lblLiebre" text="La Liebre: ¡Lista para correr!"/>
            <ProgressBar fx:id="barraLiebre" progress="0.0"/>
        </VBox>

        <VBox alignment="CENTER" spacing="20.0">
            <Label fx:id="lblTortuga" text="La Tortuga: ¡Lista para correr!"/>
            <ProgressBar fx:id="barraTortuga" progress="0.0"/>
        </VBox>

    </children>

    <padding>
        <Insets bottom="30.0" left="25.0" right="25.0" top="30.0"/>
    </padding>

</VBox>
